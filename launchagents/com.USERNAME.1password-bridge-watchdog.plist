<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.USERNAME.1password-bridge-watchdog</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.claude/bin/1password-bridge-heal.sh</string>
    </array>
    <key>WatchPaths</key>
    <array>
        <string>/Applications/1Password.app/Contents/Info.plist</string>
    </array>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>__HOME__/.claude/logs/1password-bridge-watchdog.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.claude/logs/1password-bridge-watchdog.err.log</string>
</dict>
</plist>
